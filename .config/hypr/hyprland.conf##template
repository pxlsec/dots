source = ~/.config/hypr/colors.conf
source = variables.conf

# Monitors
{% if yadm.hostname == "wyvern" %}
monitorv2 {
  output = DP-3
  mode = 2560x1440@239.97200
  bitdepth = 10
  cm = dcip3
  position = 0x0
  sdrsaturation = 1.4
  sdrbrightness = 1.1
sdr_min_luminance = 0.005
  # sdr_eotf = 2
}
{% else %}
  {% if yadm.hostname == "medusa" %}
  monitor=eDP-1,1920x2501080@60,0x0,1
  monitor=HDMI-A-1,1920x1080@60,auto,1,mirror,eDP-1
  {% else %}
  monitor=,preferred,auto,1
  {% endif %}
{% endif %}

# Default apps
$BAR=waybar
$NOTIFICATIONS=dunst
$WALLPAPER=mpvpaper --auto-pause --fork --mpv-options "--no-audio --loop-playlist --save-position-on-quit=no --panscan=1" all ~/Pictures/Wallpapers/Live/hydrangeas-rain.3840x2160.mp4
$TERM=kitty
$BROWSER=zen-browser
$MUSIC=spotify --disable-gpu

# Startup apps
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user start hyprpolkitagent
exec-once = hypridle 
exec-once = $WALLPAPER
exec-once = $BAR
exec-once = $NOTIFICATIONS
exec-once = systemctl --user start opentabletdriver.service 
exec-once = $MUSIC
exec-once = discord
exec-once = $BROWSER
exec-once = steam -silent

exec = hyprctl switchxkblayout all 1

{% if yadm.hostname == "medusa" %}
env = LIBVA_DRIVER_NAME,iHD
env = VDPAU_DRIVER,va_gl
{% endif %}

env = GTK_THEME,Adwaita:dark
env = QT_STYLE_OVERRIDE,adwaita-dark # Requires "adwaita-qt5" and "adwaita-qt6"

env = HYPRCURSOR_THEME,Vimix-cursors # Requires "vimix-cursors"
env = HYPRCURSOR_SIZE,32
env = XCURSOR_THEME,Vimix-cursors
env = XCURSOR_SIZE,32

input {

  kb_layout = us,us
    kb_variant = ,colemak
    kb_model = pc105
    kb_options = caps:backspace
    kb_rules =

    touchpad {
      natural_scroll = yes
      disable_while_typing = yes
      scroll_factor = 0.3
    }

    accel_profile = custom 2 0 1 # Compensate for high DPI in cursor mode
}

cursor {
    no_hardware_cursors = 1
}

device {
    name = compx-x2-wireless # why cant i match against compx-x2-wireless*
    accel_profile = custom 2 0 1 # Compensate for high DPI in cursor mode
}

gestures {
# See https://wiki.hyprland.org/Configuring/Variables/ for more
  workspace_swipe_distance = 1
}

general {
  gaps_in = 4
  gaps_out = 6

  border_size = 0
  col.active_border = $primary_fixed $secondary_fixed 30deg
  col.inactive_border = $surface_container
  
  # col.active_border = rgba(595959ee) rgba(505050ee) 30deg
  # col.inactive_border = rgba(454545ee)

  layout = dwindle

  allow_tearing = true
}

decoration {
  rounding = 8
  blur {
    size = 6
    passes = 3
    noise = 0.06
    contrast = 0.9
    brightness = 0.9
popups = true
  }
  shadow {
    enabled = false
  }
}

animations {
  enabled = yes

  bezier = easeCubic, 0.33, 1, 0.68, 1

  animation = windows, 0
  animation = workspaces, 1, 2, easeCubic, fade
  animation = fade, 1, 2, easeCubic
}

render {
  new_render_scheduling = false
  direct_scanout = 0
}

misc {
   vrr = 3
   enable_anr_dialog = false
   disable_hyprland_logo = true
   disable_splash_rendering = true
}

workspace = 2, monitor:$PRIMARY, default:true
workspace = 5, monitor:$SECONDARY, default:true

# Windowrules
## Rules are evaluated top to bottom, so the order they’re written in does matter!

## Zen Browser 
windowrule = match:class zen, workspace 2 silent
windowrule = match:class zen, content video

windowrule = match:class zen, match:title Picture-in-Picture, tag +pip
# windowrule = tag +pip, class:(discord), initialTitle:(Discord Popout) # Discord sets initialTitle atfer the window has spawned
windowrule = match:tag pip, float on
windowrule = match:tag pip, size 30% 30%
windowrule = match:tag pip, move 70% 70%
# windowrule = move 70%-w-6 70%-h-6, tag:pip # Simply doesn't work
windowrule = match:tag pip, pin on


windowrule = match:class PureRef, tag +pip

# Discord 
windowrule = match:class discord, workspace 5 silent

# Spotify
windowrule = match:class spotify, workspace 5 silent

# MPV
windowrule = match:class mpv, float on
windowrule = match:class mpv, size 1280 720

# wofi
layerrule = match:namespace waybar, blur on
layerrule = match:namespace rofi, blur on

layerrule = match:namespace waybar, ignore_alpha .75
layerrule = match:namespace rofi, ignore_alpha .75

# Steam
windowrule = match:class steam, workspace 1 silent, 
windowrule = match:title Steam, workspace 1 silent # The initial update prompt has no class.

# Games
windowrule = match:class gamescope, content game
windowrule = match:class steam_app_\d+, content game # Only works for x11 driver
windowrule = match:class cs2, content game
windowrule = match:title ^[Mm]inecraft.*, content game
windowrule = match:class osu!, content game

windowrule = match:content 3, immediate on
windowrule = match:content 3, workspace 1 silent
windowrule = match:content 3, idle_inhibit focus

# Pop ups
windowrule = match:class yad, float on
windowrule = match:class zenity, float on

# Lunar
windowrule = match:title lunar, float on

# keybinds
source = ~/.config/hypr/keybinds.conf

debug {
  disable_logs = true
}

ecosystem {
  no_update_news = true
  no_donation_nag = true
}
