source = ~/.config/hypr/colors.conf

# Monitors
{% if yadm.hostname == "wyvern" %}
monitorv2 {
  output = DP-1
  mode = 2560x1440@239.97200
  bitdepth = 10
  cm = srgb
  position = 0x0
  sdr_min_luminance = 0.005
  sdr_max_luminance = 250
  min_luminance = 0
}
{% else %}
  {% if yadm.hostname == "medusa" %}
  monitor=eDP-1,1920x1080@60,0x0,1
  monitor=HDMI-A-1,1920x1080@60,auto,1,mirror,eDP-1
  {% else %}
  monitor=,preferred,auto,1
  {% endif %}
{% endif %}

# Default apps
$BAR=waybar
$NOTIFICATIONS=dunst
$WALLPAPER=swww-daemon # mpvpaper --auto-stop --fork --mpv-options "--input-ipc-server=/tmp/mpv-socket --no-audio --loop-playlist --speed=0.66 --save-position-on-quit=no" DP-1 ~/Wallpapers/Live/mylivewallpapers-com-Cyberpunk-Oni-Mask-Babe-4K-EDIT.mp4
$TERM=kitty
$BROWSER=zen-browser
$MUSIC=spotify
$DISCORD=discord

# Startup apps
exec-once = systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
exec-once = systemctl --user start hyprpolkitagent
exec-once = hypridle 
exec-once = $WALLPAPER
exec-once = $BAR
exec-once = $NOTIFICATIONS
exec-once = systemctl --user start opentabletdriver.service 
exec-once = $MUSIC
exec-once = $DISCORD
exec-once = $BROWSER
exec-once = steam -silent

exec = hyprctl switchxkblayout all 1

# Some default env vars.
{% if yadm.hostname == "medusa" %}
env = LIBVA_DRIVER_NAME,iHD
env = VDPAU_DRIVER,va_gl
{% endif %}

#env = QT_QPA_PLATFORMTHEME,qt6ct

env = HYPRCURSOR_THEME,Vimix-cursors
env = HYPRCURSOR_SIZE,32
env = XCURSOR_THEME,Vimix-cursors
env = XCURSOR_SIZE,32

# Theme
env = QT_STYLE_OVERRIDE,kvantum
env = GTK_THEME,kvantum:dark

# Source a file (multi-file configs)
# source = ~/.config/hypr/myColors.conf

input {

  kb_layout = us,us
    kb_variant = ,colemak
    kb_model = pc105
    kb_options = caps:backspace
    kb_rules =

    # mouse_refocus = 0 # Seems to cause issues on net ease games
    touchpad {
      natural_scroll = yes
      disable_while_typing = yes
      scroll_factor = 0.3
    }

    accel_profile = custom 2 0 1 # Compensate for high DPI in cursor mode
}

device {
    name = compx-x2-wireless # why cant i match against compx-x2-wireless*
    accel_profile = custom 2 0 1 # Compensate for high DPI in cursor mode
}

gestures {
# See https://wiki.hyprland.org/Configuring/Variables/ for more
  workspace_swipe_distance = 1
}

general {
  gaps_in = 4
  gaps_out = 6

  border_size = 0
  col.active_border = $primary_fixed $secondary_fixed 30deg
  col.inactive_border = $surface_container
  
  # col.active_border = rgba(595959ee) rgba(505050ee) 30deg
  # col.inactive_border = rgba(454545ee)

  layout = dwindle

  allow_tearing = true
}

decoration {
  rounding = 8
  blur {
    size = 6
    passes = 3
    noise = 0.06
    contrast = 0.9
    brightness = 0.9
popups = true
  }
  shadow {
    enabled = false
  }
}

animations {
  enabled = yes

  bezier = easeCubic, 0.33, 1, 0.68, 1

  animation = windows, 0
  animation = workspaces, 1, 2, easeCubic, fade
  animation = fade, 1, 2, easeCubic
}

render {
  new_render_scheduling = false
  direct_scanout = 2
}

misc {
   vrr = 3
   key_press_enables_dpms = true
   enable_anr_dialog = false
   disable_hyprland_logo = true
   disable_splash_rendering = true
}

# Windowrules
## Rules are evaluated top to bottom, so the order they’re written in does matter!

## Zen Browser 
windowrule = workspace 2 silent, class:(zen)
windowrule = content video, class:(zen)

windowrule = tag +pip, class:(zen), title:(Picture-in-Picture)
# windowrule = tag +pip, class:(discord), initialTitle:(Discord Popout) # Discord sets initialTitle atfer the window has spawned
windowrule = float, tag:pip
windowrule = size 30% 30%, tag:pip
windowrule = move 70% 70%, tag:pip
# windowrule = move 70%-w-6 70%-h-6, tag:pip # Simply doesn't work
windowrule = pin, tag:pip

# Discord 
windowrule = workspace 5 silent, class:(discord)

# Spotify
windowrule = workspace 5 silent, class:(Spotify)

# MPV
windowrule = float, class:(mpv)
windowrule = size 1280 720, class:(mpv)

# wofi
layerrule = blur, waybar
layerrule = blur, rofi

layerrule = ignorezero, waybar
layerrule = ignorezero, rofi

# Steam
windowrule = workspace 1 silent, class:(steam)
windowrule = workspace 1 silent, title:(Steam) # The initial update prompt has no class.

# Games
windowrule = content game, class:(gamescope)
windowrule = content game, class:(steam_app_\d+) # Only works for x11 driver
windowrule = content game, class:(cs2)
windowrule = content game, title:(Minecraft.*)
windowrule = content game, class:(osu!)

windowrule = immediate, content:game
windowrule = workspace 1 silent, content:game
windowrule = idleinhibit focus, content:game

# Pop ups
windowrule = float, class:(yad)
windowrule = float, class:(zenity)

# Lunar
windowrule = float, title:(lunar)

# keybinds
source = ~/.config/hypr/keybinds.conf

experimental {
  xx_color_management_v4 = true
}

debug {
  disable_logs = true
}

ecosystem {
  no_update_news = true
  no_donation_nag = true
}
