# Style
font-family = "FiraCode Nerd Font Mono"
font-size = 11

# Valid values are:
# 
#   * `block`
#   * `bar`
#   * `underline`
#   * `block_hollow`
cursor-style = bar

theme = xcad

background-opacity = 0.8

window-decoration = false
confirm-close-surface = false

# keybinds
# keybind = ctrl+z=close_surface
# keybind = ctrl+d=new_split:right
