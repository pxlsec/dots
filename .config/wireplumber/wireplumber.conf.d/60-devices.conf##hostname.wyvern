monitor.alsa.rules = [
  
# Disable unused devices
  
  {
    matches = [
      {
        # Microphone sink
        node.name = "alsa_output.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-stereo"
      },
      {
       # HDMI sink
        device.name = "alsa_card.pci-0000_67_00.1"
      },
      {
        # Stereo source
        device.name = "alsa_card.pci-0000_00_1f.3"
      },
    ]
    actions = {
      update-props = {
        device.disabled = true
        node.disabled = true
      }
    }
  },

# Rename devices

  {
    matches = [
      {
        # Microphone source
        node.name = "alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        node.description = "Rode NT USB"
        audio.rate = 48000
        # Following value should be doubled until audio does not cut out or other issues stop occurring
        api.alsa.period-size = 256
      }
    }
  },
  {
    matches = [
      {
        # Headphone sink
        node.name = "alsa_output.usb-FIIO_FIIO_KA15-01.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        node.description = "FIIO KA15"
        # audio.format = "S32_LE" # Not working?
        alsa.resolution_bits = "32"
        audio.rate = 48000

        # Following value should be doubled until audio does not cut out or other issues stop occurring
        api.alsa.headroom      = 128
        resample.quality = 10
      }
    }
  }
]
