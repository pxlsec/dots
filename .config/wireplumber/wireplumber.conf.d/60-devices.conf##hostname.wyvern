monitor.alsa.rules = [
  
# Disable unused devices
  
  {
    matches = [
      {
        # Microphone sink
        node.name = "alsa_output.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-stereo"
      },
      {
       # HDMI sink
        node.name = "alsa_output.pci-0000_67_00.1.hdmi-stereo"
      },
      {
        # Stereo source
        node.name = "alsa_input.pci-0000_00_1f.3.analog-stereo"
      },
    ]
    actions = {
      update-props = {
        node.disabled = true
      }
    }
  },

# Rename devices

  {
    matches = [
      {
        # Microphone source
        node.name = "alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        node.description = "Rode NT USB"
      }
    }
  },
  {
    matches = [
      {
        # Headphone sink
        node.name = "alsa_output.pci-0000_00_1f.3.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        node.description = "Sennheiser HD 560S"
      }
    }
  },

# Change samplerate
  
  {
    matches = [
      {
        # Microphone source
        node.name = "alsa_input.usb-C-Media_Electronics_Inc._USB_PnP_Sound_Device-00.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        audio.format = "S16_LE"
        audio.rate = 48000
        # Following value should be doubled until audio does not cut out or other issues stop occurring
        api.alsa.period-size = 16
      }
    }
  },
  {
    matches = [
      {
        # Headphone sink
        node.name = "alsa_output.pci-0000_00_1f.3.analog-stereo"
      }
    ]
    actions = {
      update-props = {
        audio.format = "S32_LE"
        audio.rate = 48000
        # Following value should be doubled until audio does not cut out or other issues stop occurring
        api.alsa.period-size = 16
      }
    }
  }
]
