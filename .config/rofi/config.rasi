configuration {
	  font:							      "FiraCode Nerd Font 12";
    show-icons:             true;
	  icon-theme: 				  	"Papirus";
    display-drun: 					" ";
    drun-display-format:    "{name}";
    disable-history:        false;
	  sidebar-mode: 					false;
}

@import "colors.rasi"

window {
	  border:							    0px;
    border-radius:          8px;
	  width:							    35%;
    location:               center;
}

inputbar {
    background-color:       @selected-normal-background;
    border-radius:          8px;
    padding:                12px;
}

prompt {
    margin:                 -2px 0px -20px 0px;
	  font:							      "FiraCode Nerd Font 14";
}

textbox-prompt-colon {
    str:                    "";
}

entry {
    placeholder:            "Search...";
}

listview {
    background-color:       transparent;
    fixed-columns:          true;
    columns:                5;
    lines:                  3;
    spacing:                2px;
    scrollbar:              false;
    dynamic:                true;
    cycle:                  false;
    layout:                 vertical;
    flow:                   horizontal;
}

mainbox {
    background-color:       transparent;
    padding:                6px;
}

element {
    orientation:            vertical;
    padding:                16px 0px 20px 0px;
}

element-icon {
    size:                   48px;
}

element-text {
    horizontal-align:       0.5;
    vertical-align:         0.5;
    margin:                 0.5% 0.5% -0.5% 0.5%;
}

element selected {
    border-radius:          8px;
}
